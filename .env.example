SPLAT_PUBLIC_URL=https://errors.example.com
SPLAT_ADMIN_USERNAME=admin
# First-boot only: 16+ chars, unique, never a placeholder. Startup refuses
# weak values (e.g. change-me). Generate with: openssl rand -base64 24
SPLAT_ADMIN_PASSWORD=
SPLAT_SESSION_SECRET=
# Database (sqlite is default):
# SPLAT_DB_DRIVER=sqlite
# SPLAT_DB_PATH=data/splat.db
# Postgres (optional):
# SPLAT_DB_DRIVER=postgres
# SPLAT_DATABASE_URL=postgres://splat:${POSTGRES_PASSWORD}@localhost:5432/splat?sslmode=disable
# POSTGRES_USER=splat
# POSTGRES_PASSWORD=
# POSTGRES_DB=splat
# Observability (all optional, all off by default):
# SPLAT_METRICS=1
# SPLAT_LOG_LEVEL=info
# Single sign-on (generic OIDC, optional, off by default):
# SPLAT_OIDC_ISSUER=https://auth.example.com/realms/splat
# SPLAT_OIDC_CLIENT_ID=splat
# SPLAT_OIDC_CLIENT_SECRET=
# SPLAT_OIDC_NAME=Company SSO
# SPLAT_OIDC_SCOPES=openid email profile
# The redirect URI is {SPLAT_PUBLIC_URL}/api/v1/sso/callback - register
# it at the provider. Password login can be disabled in Settings once
# SSO works.
