{
  "openapi": "3.1.0",
  "info": {
    "title": "Errgotrack API",
    "version": "1.0.0",
    "description": "JSON API for the Errgotrack dashboard SPA plus the Sentry-compatible ingestion endpoints. Dashboard endpoints authenticate with the session cookie set by POST /api/v1/login (401 JSON when missing)."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "cookieAuth": [] }],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "errgotrack_session"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key secret (egt_...). Scopes: ingest (event ingestion), read (GET API), write (mutating API). A key bound to a project is confined to that project's ingestion and reads; instance routes (settings, rules, storage, key management) need the admin session or an unbound key, and key management needs the admin session."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      },
      "Point": {
        "type": "object",
        "required": ["label", "value"],
        "properties": { "label": { "type": "string" }, "value": { "type": "integer" } }
      },
      "Dashboard": {
        "type": "object",
        "properties": {
          "range": { "type": "string" },
          "stats": {
            "type": "object",
            "properties": {
              "totalEvents": { "type": "integer" },
              "unresolvedIssues": { "type": "integer" },
              "newIssues": { "type": "integer" },
              "affectedProjects": { "type": "integer" },
              "eventsToday": { "type": "integer" },
              "uniqueIssues": { "type": "integer" },
              "eventsDeltaPct": { "type": "number" },
              "eventsDeltaLabel": { "type": "string" }
            }
          },
          "charts": {
            "type": "object",
            "properties": {
              "eventsOverTime": { "type": "array", "items": { "$ref": "#/components/schemas/Point" } },
              "byProject": { "type": "array", "items": { "$ref": "#/components/schemas/Point" } },
              "topExceptions": { "type": "array", "items": { "$ref": "#/components/schemas/Point" } },
              "byEnvironment": { "type": "array", "items": { "$ref": "#/components/schemas/Point" } },
              "newVsRecurring": {
                "type": "object",
                "properties": { "new": { "type": "integer" }, "recurring": { "type": "integer" } }
              },
              "byStatus": { "type": "array", "items": { "$ref": "#/components/schemas/Point" } }
            }
          },
          "recentIssues": { "type": "array", "items": { "$ref": "#/components/schemas/IssueListItem" } },
          "hasData": { "type": "boolean" },
          "hasProjects": { "type": "boolean" }
        }
      },
      "IssueListItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "culprit": { "type": "string" },
          "level": { "type": "string" },
          "projectName": { "type": "string" },
          "environment": { "type": "string" },
          "eventCount": { "type": "integer" },
          "userCount": { "type": "integer" },
          "lastSeen": { "type": "string", "format": "date-time" },
          "lastSeenRelative": { "type": "string" },
          "sparkline": { "type": "array", "items": { "type": "integer" } }
        }
      },
      "IssueList": {
        "type": "object",
        "properties": {
          "issues": { "type": "array", "items": { "$ref": "#/components/schemas/IssueListItem" } },
          "total": { "type": "integer" },
          "page": { "type": "integer" },
          "totalPages": { "type": "integer" },
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
            }
          },
          "environments": { "type": "array", "items": { "type": "string" } }
        }
      },
      "KeyValue": {
        "type": "object",
        "required": ["key", "value"],
        "properties": { "key": { "type": "string" }, "value": { "type": "string" } }
      },
      "StackFrame": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "col": { "type": "integer" },
          "function": { "type": "string" },
          "module": { "type": "string" },
          "contextLine": { "type": "string" },
          "preContext": { "type": "array", "items": { "type": "string" } },
          "postContext": { "type": "array", "items": { "type": "string" } },
          "vars": { "type": "array", "items": { "$ref": "#/components/schemas/KeyValue" } },
          "inApp": { "type": "boolean" },
          "original": {
            "type": ["object", "null"],
            "properties": {
              "source": { "type": "string" },
              "line": { "type": "integer" },
              "column": { "type": "integer" },
              "function": { "type": "string" },
              "context": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      },
      "IssueDetail": {
        "type": "object",
        "properties": {
          "issue": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "title": { "type": "string" },
              "exceptionType": { "type": "string" },
              "exceptionValue": { "type": "string" },
              "culprit": { "type": "string" },
              "level": { "type": "string" },
              "status": { "type": "string", "enum": ["unresolved", "resolved", "ignored", "muted"] },
              "mutedUntil": { "type": ["string", "null"], "format": "date-time", "description": "Mute expiry, or null when not muted / muted forever." },
              "resolvedInRelease": { "type": "string", "description": "Release pin for resolve-in-next-release, or empty." },
              "eventCount": { "type": "integer" },
              "userCount": { "type": "integer" },
              "firstSeen": { "type": "string", "format": "date-time" },
              "lastSeen": { "type": "string", "format": "date-time" },
              "environment": { "type": "string" },
              "release": { "type": "string" }
            }
          },
          "project": {
            "type": "object",
            "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
          },
          "tags": { "type": "array", "items": { "$ref": "#/components/schemas/KeyValue" } },
          "user": { "type": ["object", "null"] },
          "sdk": { "type": ["object", "null"] },
          "request": { "type": ["object", "null"] },
          "contexts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "fields": { "type": "array", "items": { "$ref": "#/components/schemas/KeyValue" } }
              }
            }
          },
          "breadcrumbs": { "type": "array", "items": { "type": "object" } },
          "stacktrace": { "type": "array", "items": { "$ref": "#/components/schemas/StackFrame" } },
          "events": { "type": "array", "items": { "type": "object" } },
          "latestEventId": { "type": ["string", "null"] },
          "currentEventId": { "type": ["string", "null"] },
          "traceId": { "type": "string" },
          "traceURL": { "type": "string" }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "defaultEnvironment": { "type": "string" },
          "enabled": { "type": "boolean" },
          "retentionDays": { "type": "integer", "description": "0 keeps events forever (the default)." },
          "platform": { "type": "string" },
          "platformLabel": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "events7d": { "type": "integer" },
          "unresolved": { "type": "integer" }
        }
      },
      "ProjectDetail": {
        "type": "object",
        "properties": {
          "project": { "$ref": "#/components/schemas/Project" },
          "dsn": { "type": "string" },
          "stats": {
            "type": "object",
            "properties": { "events7d": { "type": "integer" }, "unresolved": { "type": "integer" } }
          },
          "environments": { "type": "array", "items": { "type": "string" } },
          "platformLabel": { "type": "string" },
          "platformInstall": { "type": "string" },
          "platformSnippet": { "type": "string" },
          "platforms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "id": { "type": "string" }, "label": { "type": "string" } }
            }
          }
        }
      },
      "Settings": {
        "type": "object",
        "properties": {
          "telegram": {
            "type": "object",
            "properties": { "chatId": { "type": "string" }, "enabled": { "type": "boolean" } }
          },
          "botTokenMasked": { "type": "string" },
          "webhooks": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": { "urlMasked": { "type": "string" }, "enabled": { "type": "boolean" } }
            }
          },
          "smtp": { "$ref": "#/components/schemas/SMTPSettings" },
          "traceURLTemplate": { "type": "string" }
        }
      },
      "SMTPSettings": {
        "type": "object",
        "properties": {
          "host": { "type": "string" },
          "port": { "type": "integer" },
          "username": { "type": "string" },
          "passwordMasked": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "useTLS": { "type": "boolean" },
          "enabled": { "type": "boolean" }
        }
      },
      "AlertRule": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "projectId": { "type": ["integer", "null"], "description": "Null means all projects." },
          "environment": { "type": "string" },
          "notifyNewIssue": { "type": "boolean" },
          "notifyThreshold": { "type": "integer" },
          "notifyReopened": { "type": "boolean" },
          "cooldownSeconds": { "type": "integer" },
          "channels": {
            "type": "array",
            "items": { "type": "string", "enum": ["telegram", "slack", "discord", "teams", "sheets", "email"] },
            "description": "Empty means every enabled channel."
          }
        }
      },
      "SourceMapMeta": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "release": { "type": "string" },
          "bundleUrl": { "type": "string" },
          "sizeBytes": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "ProjectOverview": {
        "type": "object",
        "properties": {
          "period": { "type": "string" },
          "events": { "type": "integer" },
          "newIssues": { "type": "integer" },
          "openIssues": { "type": "integer" },
          "volumeBySeverity": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bucket": { "type": "string" },
                "counts": { "type": "object", "additionalProperties": { "type": "integer" } }
              }
            }
          },
          "topIssues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "integer" },
                "title": { "type": "string" },
                "level": { "type": "string" },
                "status": { "type": "string" },
                "eventCount": { "type": "integer" },
                "lastSeen": { "type": "string", "format": "date-time" },
                "lastSeenRelative": { "type": "string" }
              }
            }
          }
        }
      },
      "ReleaseHealth": {
        "type": "object",
        "properties": {
          "release": { "type": "string" },
          "events": { "type": "integer" },
          "issues": { "type": "integer" },
          "sessions": { "type": "integer" },
          "users": { "type": "integer" },
          "crashFreeSessions": { "type": "number" },
          "crashFreeUsers": { "type": "number" },
          "firstSeen": { "type": "string" },
          "lastSeen": { "type": "string" }
        }
      },
      "SessionSummary": {
        "type": "object",
        "properties": {
          "period": { "type": "string" },
          "summary": {
            "type": "object",
            "properties": {
              "totalSessions": { "type": "integer" },
              "users": { "type": "integer" },
              "crashFreeSessions": { "type": "number" },
              "crashFreeUsers": { "type": "number" }
            }
          },
          "timeseries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bucket": { "type": "string" },
                "healthy": { "type": "integer" },
                "crashed": { "type": "integer" }
              }
            }
          }
        }
      },
      "GenericWebhook": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "url": { "type": "string" },
          "hasSecret": { "type": "boolean" },
          "headers": { "type": "object", "additionalProperties": { "type": "string" } },
          "enabled": { "type": "boolean" }
        }
      },
      "StorageUsage": {
        "type": "object",
        "properties": {
          "driver": { "type": "string", "enum": ["sqlite", "postgres"] },
          "sizeBytes": { "type": "integer" },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "name": { "type": "string" }, "rows": { "type": "integer" } }
            }
          }
        }
      },
      "APIKey": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "prefix": { "type": "string", "description": "First characters of the secret, for identification." },
          "projectId": { "type": ["integer", "null"], "description": "Null means all projects." },
          "scopes": { "type": "array", "items": { "type": "string", "enum": ["ingest", "read", "write"] } },
          "expiresAt": { "type": "string", "description": "RFC3339, or empty for never." },
          "revoked": { "type": "boolean" },
          "lastUsedAt": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "secret": { "type": "string", "description": "Only present at creation/rotation. Shown once." }
        }
      }
    }
  },
  "paths": {
    "/api/v1/login": {
      "post": {
        "summary": "Log in",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": { "username": { "type": "string" }, "password": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Logged in; session cookie set." },
          "401": { "description": "Bad credentials.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Session status",
        "security": [],
        "responses": { "200": { "description": "Always 200; authenticated flag tells the truth." } }
      }
    },
    "/api/v1/logout": {
      "post": { "summary": "Log out", "security": [], "responses": { "200": { "description": "Logged out." } } }
    },
    "/api/v1/dashboard": {
      "get": {
        "summary": "Dashboard stats and charts",
        "parameters": [
          {
            "name": "range",
            "in": "query",
            "schema": { "type": "string", "enum": ["1h", "24h", "7d", "30d"], "default": "24h" }
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard data.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Dashboard" } } }
          }
        }
      }
    },
    "/api/v1/issues": {
      "get": {
        "summary": "List issues",
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "project", "in": "query", "schema": { "type": "integer" } },
          { "name": "environment", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["unresolved", "resolved", "ignored", "muted"] } },
          { "name": "sort", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "Issue page.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IssueList" } } }
          }
        }
      }
    },
    "/api/v1/issues/bulk": {
      "post": {
        "summary": "Bulk status change",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ids", "status"],
                "properties": {
                  "ids": { "type": "array", "items": { "type": "integer" } },
                  "status": { "type": "string", "enum": ["unresolved", "resolved", "ignored", "muted"] }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Updated." } }
      }
    },
    "/api/v1/issues/{id}": {
      "get": {
        "summary": "Issue detail",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "event", "in": "query", "description": "Event ID; defaults to latest.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Issue with event detail.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IssueDetail" } } }
          },
          "404": { "description": "Not found." }
        }
      }
    },
    "/api/v1/issues/{id}/status": {
      "post": {
        "summary": "Set issue status",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": { "type": "string", "enum": ["unresolved", "resolved", "ignored", "muted"] },
                  "mutedUntil": { "type": "string", "description": "RFC3339 expiry for status muted; empty mutes forever." },
                  "resolveInRelease": { "type": "boolean", "description": "With status resolved: pin to the issue's current release and reopen only on a different release." }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Updated." } }
      }
    },
    "/api/v1/projects": {
      "get": {
        "summary": "List projects",
        "responses": {
          "200": {
            "description": "Projects.",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Project" } }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create project",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "slug"],
                "properties": {
                  "name": { "type": "string" },
                  "slug": { "type": "string" },
                  "defaultEnvironment": { "type": "string" },
                  "platform": { "type": "string" },
                  "retentionDays": { "type": "integer", "description": "0 keeps events forever (the default)." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created; returns full detail.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectDetail" } } }
          },
          "409": { "description": "Slug taken." }
        }
      }
    },
    "/api/v1/projects/{id}": {
      "get": {
        "summary": "Project detail",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "Project detail.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectDetail" } } }
          }
        }
      },
      "patch": {
        "summary": "Update project",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "defaultEnvironment": { "type": "string" },
                  "platform": { "type": "string" },
                  "retentionDays": { "type": "integer", "description": "0 keeps events forever (the default)." },
                  "enabled": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated detail.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectDetail" } } }
          }
        }
      },
      "delete": {
        "summary": "Delete project",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Deleted." } }
      }
    },
    "/api/v1/projects/{id}/rotate": {
      "post": {
        "summary": "Rotate project DSN key",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "Updated detail with new DSN.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectDetail" } } }
          }
        }
      }
    },
    "/api/v1/platforms": {
      "get": {
        "summary": "Setup snippet platforms",
        "responses": { "200": { "description": "Platform id/label pairs." } }
      }
    },
    "/api/v1/projects/{id}/overview": {
      "get": {
        "summary": "Project overview bento (counters, severity volume, top issues)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "period", "in": "query", "schema": { "type": "string", "enum": ["24h", "7d", "30d"], "default": "24h" } }
        ],
        "responses": {
          "200": {
            "description": "Overview data.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectOverview" } } }
          }
        }
      }
    },
    "/api/v1/projects/{id}/releases": {
      "get": {
        "summary": "Per-release rollup (events, issues, sessions, crash-free rates)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "Releases, most recently active first.",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ReleaseHealth" } }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{id}/sessions/summary": {
      "get": {
        "summary": "Crash-free summary plus session-health timeseries",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
